  create view "postgres"."dbt_dev"."stg_tank_measurements__dbt_tmp"
    
    
  as (
    select
    s.id,
    s.source_file,
    s.report_time,
    s.tank_scope,
    s.tank_id,
    s.product as raw_product,
    s.level_m,
    s.average_temperature_c,
    s.temperature_1_c,
    s.net_standard_volume_m3,
    s.reference_density_kg_m3,
    s.depot_code,
    s.tank_id_raw,
    s.ullage_m,
    s.tov_m3,
    s.wia_ton,
    s.level_status,
    s.nsv_diff,
    s.quality_flags,
    case
        when s.depot_code is not null
            and trim(s.depot_code) <> ''
            and s.tank_id_raw is not null
            and trim(s.tank_id_raw) <> ''
        then concat(trim(s.depot_code), '-', trim(s.tank_id_raw))
    end as tank_reference,
    p.standard_product,
    (p.standard_product is not null) as has_mapping
from "postgres"."public"."tank_measurements" as s
left join "postgres"."dbt_dev"."ref_tank_products_simple" as p
    on lower(trim(s.depot_code)) = lower(trim(p.depot_code))
    and lower(trim(s.tank_id_raw)) = lower(trim(p.tank_id_raw))
    and lower(trim(s.product)) = lower(trim(p.raw_product))
  );
